# Build output
/target/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.idea/
*.iml
.vscode/
*.swp


# Server config (nginx/deploy config at project root — NOT the Java config package).
# Contents ignored rather than the directory itself so single files can be re-included.
/config/*
# ...except the nginx site config: no secrets (paths only), and its routing rules
# (bracket.txt over plain HTTP, actuator 404) deserve history
!/config/mysite

# OS
.DS_Store
Thumbs.db

# Git worktrees
.worktrees/

# Visual brainstorming session artifacts
.superpowers/

# Netdata postgres collector config — rendered from .env by deploy.sh (contains DB password)
/netdata/go.d/postgres.conf

# ML model artifacts (runtime artifacts produced by trainer; not versioned)
models/*.onnx
models/features.json
/scripts/local_start_app.sh
.venv/

# Claude Code local settings (per-machine, not shared)
.claude/settings.local.json
