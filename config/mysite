# Timed access log for Netdata's web_log collector. goaccess.log stays strict COMBINED
# because goaccess parses it with --log-format=COMBINED; this is a second, additive log.
log_format netdata_timing '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" '
                          '"$http_user_agent" rt=$request_time urt=$upstream_response_time';

# WebSocket upgrade passthrough for the Netdata dashboard proxy below.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── Anonymous page cache ─────────────────────────────────────────────────────
# Nearly every public page is identical for every signed-out visitor and its
# data changes only after scrapes, so a short shared cache absorbs bursts and
# keeps one slow endpoint from starving the app's thread/connection pools.
# Cache storage is ephemeral inside the nginx container — safe to lose.
proxy_cache_path /var/cache/nginx/deepfij levels=1:2 keys_zone=deepfij:10m
                 max_size=200m inactive=10m use_temp_path=off;

# Any session or remember-me cookie means a potentially personalized page
# (nav shows the username, follow buttons, etc.) — never serve those from cache.
map $http_cookie $deepfij_cookie_skip {
    default        0;
    ~JSESSIONID    1;
    ~remember-me   1;
}

# Auth, account, and admin flows are never cached regardless of cookies
# (CSRF tokens, personal data, login forms).
map $request_uri $deepfij_uri_skip {
    default 0;
    ~^/(admin|account|login|logout|register|verify|forgot-password|reset-password|error) 1;
}

# ── Bot control ──────────────────────────────────────────────────────────────
# SEO backlink/rank crawlers are ~30% of all requests and worth nothing to a
# college-basketball site. They honor robots.txt, but dropping them here costs
# nothing and doesn't depend on their good behaviour. Search engines
# (Googlebot, Bingbot, DuckDuckBot, Applebot) and AI *answer* fetchers are not
# listed — AI *training* crawlers are governed by robots.txt only, so that
# policy can change without touching nginx.
map $http_user_agent $deepfij_drop_bot {
    default 0;
    ~*AhrefsBot              1;
    ~*SemrushBot             1;
    ~*MJ12bot                1;
    ~*SERankingBacklinksBot  1;
    ~*DotBot                 1;
    ~*PetalBot               1;
    ~*Sogou                  1;
    ~*Baiduspider            1;
    ~*BLEXBot                1;
    ~*DataForSeoBot          1;
    ~*Barkrowler             1;
}

# Per-IP rate limit for page requests. The Nov 2026 scrapers ran ~1.5 req/s for
# hours from single residential IPs with a forged Chrome UA — a human never
# sustains that. Static assets (/css /js /img, content-hashed + 7d cached) are
# exempt so a cold page load's burst of assets isn't counted. 1r/s with a burst
# of 60 lets a real visitor click freely but caps any one IP at ~3.6k pages/hour.
# Keyed on the normalized $uri, not the raw $request_uri, so "/css/../teams/1"
# can't claim the static exemption. News thumbnails (/news/img, served by the
# app but nginx-cached) are exempt too: a news page fetches a dozen of them in
# parallel over HTTP/2, and each parallel request counts as a connection.
map $uri $deepfij_page_key {
    default            $binary_remote_addr;
    ~^/(css|js|img)/   "";
    ~^/news/img/       "";
}
limit_req_zone $deepfij_page_key zone=deepfij_pages:10m rate=1r/s;
limit_req_status 429;
# Per-IP concurrency shares the page key so assets never count against it.
limit_conn_zone $deepfij_page_key zone=deepfij_conn:10m;
limit_conn_status 429;

# Distributed scraper signature (Oct–Nov 2026): ~23k requests from ~23k distinct
# residential IPs, one request each, forged browser UAs, and a Referer of exactly
# the bare origin with no trailing slash. A real browser never sends that — URL
# serialization always includes the "/" path, even under Referrer-Policy: origin.
# Per-IP limits can't touch a one-request-per-IP botnet, so match the header.
map $http_referer $deepfij_forged_ref {
    default                  0;
    "https://fijimf.com"     1;
    "https://www.fijimf.com" 1;
    "http://fijimf.com"      1;
    "http://www.fijimf.com"  1;
}

# Site-wide in-flight cap for page requests (static assets exempt). The box has
# 2 cores and a 25-connection DB pool; ~90 concurrent uncached page requests put
# all 200 Tomcat threads into the Hikari queue, every request waited 30s for a
# connection and failed, and even cached pages died for ~3 minutes. Shedding the
# excess with an instant 429 keeps the app answering for everyone else.
# Auth/admin paths have their own key so a flood of public pages can never
# lock an admin out; they stay under the per-IP cap. Normalized $uri, as above.
map $uri $deepfij_total_key {
    default                                   "all";
    ~^/(css|js|img)/                          "";
    ~^/news/img/                              "";
    ~^/(admin|account|login|logout)(/|$)      "";
}
limit_conn_zone $deepfij_total_key zone=deepfij_total:1m;

# Auth/admin paths get a small reserved bucket of their own (a single zone's
# limit applies per key value, so a second value in deepfij_total would have
# doubled the site-wide cap). They stay under the per-IP cap as well.
map $uri $deepfij_auth_key {
    default                                   "";
    ~^/(admin|account|login|logout)(/|$)      "auth";
}
limit_conn_zone $deepfij_auth_key zone=deepfij_auth:1m;

# News thumbnails are tiny (~20ms, nginx-cached) but are still app requests, so
# they get their own bounded buckets instead of a blanket exemption: generous
# per-IP so one news page can load its dozen in parallel, and a site-wide cap.
map $uri $deepfij_img_ip_key {
    default            "";
    ~^/news/img/       $binary_remote_addr;
}
map $uri $deepfij_img_total_key {
    default            "";
    ~^/news/img/       "img";
}
limit_conn_zone $deepfij_img_ip_key    zone=deepfij_img_ip:10m;
limit_conn_zone $deepfij_img_total_key zone=deepfij_img_total:1m;

# Thumbnails are immutable per article id: cache on $uri so "?x=<random>" can't
# bust the cache and reach the DB. Everything else keeps the query string.
map $uri $deepfij_cache_key {
    default            $scheme$host$request_uri;
    ~^/news/img/       $scheme$host$uri;
}

server {
    listen 80;
        listen [::]:80;
    server_name fijimf.com www.fijimf.com;

    # The bracket.txt easter egg must work with a naive `curl fijimf.com/bracket.txt` —
    # curl doesn't follow the HTTPS redirect by default, so serve these over plain HTTP.
    location ~ ^(/seasons/[0-9]+)?/bracket\.txt$ {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Slow clients can't park in a limit_conn slot: drop a connection that takes
    # longer than this to send its headers/body (defaults are 60s).
    client_header_timeout 15s;
    client_body_timeout 15s;

    access_log /var/log/nginx/goaccess.log combined;
    # NOTE: not access.log — in nginx:alpine that's a symlink to /dev/stdout inside the
    # nginx_logs volume, so netdata could never read it as a file.
    access_log /var/log/nginx/access_timed.log netdata_timing;

    # Compress HTML/CSS/JS/JSON — the rankings pages ship >700KB of markup
    # uncompressed. text/html is always included when gzip is on.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    # Actuator lives on the app's management port (8081, never proxied); make the
    # public path explicitly 404 instead of falling through to the app's error page.
    location /actuator/ {
        return 404;
    }

    location / {
        # 444 closes the connection without a response — no upstream call, no bytes.
        if ($deepfij_drop_bot) { return 444; }
        if ($deepfij_forged_ref) { return 444; }
        limit_req zone=deepfij_pages burst=60 nodelay;
        # Per-IP cap well under the site-wide one so no single client can hold
        # the whole shared bucket. HTTP/2 page navigation needs a few at most.
        limit_conn deepfij_conn 6;
        limit_conn deepfij_total 30;
        limit_conn deepfij_auth 8;
        limit_conn deepfij_img_ip 24;
        limit_conn deepfij_img_total 20;

        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache deepfij;
        proxy_cache_key $deepfij_cache_key;
        proxy_cache_bypass $deepfij_cookie_skip $deepfij_uri_skip;
        proxy_no_cache $deepfij_cookie_skip $deepfij_uri_skip;
        # The app marks everything no-store (Spring Security default); freshness
        # for anonymous pages is governed here instead. Set-Cookie responses are
        # still never cached (nginx default — deliberately NOT ignored).
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_valid 200 301 302 60s;
        # Short negative cache so nonexistent ids (thumbnails, games) can't be
        # enumerated straight through to the app.
        proxy_cache_valid 404 60s;
        # Collapse concurrent misses into one upstream request, and keep serving
        # a stale copy while refreshing or if the app is down/overloaded.
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status always;
    }
}

server {
    listen 8888 ssl;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    auth_basic "Analytics";
    auth_basic_user_file /etc/nginx/htpasswd;

    location /ws {
        proxy_pass http://goaccess:7890;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 7d;
    }

    location / {
        root /var/www/goaccess;
        index index.html;
        try_files $uri $uri/ =404;
    }
}

# Internal-only stub_status for Netdata's nginx collector. Port 8080 is NOT published
# in docker-compose, so it is reachable only from other containers on the compose network.
server {
    listen 8080;
    server_name _;
    access_log off;

    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        allow 172.16.0.0/12;   # docker bridge networks
        allow 192.168.0.0/16;  # docker bridge networks (later address pools)
        deny all;
    }
}

# Netdata dashboard, remote access behind TLS + basic auth.
# Requires port 9999 to be opened in the Hetzner firewall; netdata's own 19999 stays
# bound to 127.0.0.1 on the host and is never exposed directly.
server {
    listen 9999 ssl;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    auth_basic "Monitoring";
    auth_basic_user_file /etc/nginx/htpasswd;

    location / {
        proxy_pass http://netdata:19999;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1d;
        proxy_store off;
    }
}
