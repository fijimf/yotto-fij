# Timed access log for Netdata's web_log collector. goaccess.log stays strict COMBINED
# because goaccess parses it with --log-format=COMBINED; this is a second, additive log.
log_format netdata_timing '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" '
                          '"$http_user_agent" rt=$request_time urt=$upstream_response_time';

# WebSocket upgrade passthrough for the Netdata dashboard proxy below.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── Anonymous page cache ─────────────────────────────────────────────────────
# Nearly every public page is identical for every signed-out visitor and its
# data changes only after scrapes, so a short shared cache absorbs bursts and
# keeps one slow endpoint from starving the app's thread/connection pools.
# Cache storage is ephemeral inside the nginx container — safe to lose.
proxy_cache_path /var/cache/nginx/deepfij levels=1:2 keys_zone=deepfij:10m
                 max_size=200m inactive=10m use_temp_path=off;

# Any session or remember-me cookie means a potentially personalized page
# (nav shows the username, follow buttons, etc.) — never serve those from cache.
map $http_cookie $deepfij_cookie_skip {
    default        0;
    ~JSESSIONID    1;
    ~remember-me   1;
}

# Auth, account, and admin flows are never cached regardless of cookies
# (CSRF tokens, personal data, login forms).
map $request_uri $deepfij_uri_skip {
    default 0;
    ~^/(admin|account|login|logout|register|verify|forgot-password|reset-password|error) 1;
}

server {
    listen 80;
        listen [::]:80;
    server_name fijimf.com www.fijimf.com;

    # The bracket.txt easter egg must work with a naive `curl fijimf.com/bracket.txt` —
    # curl doesn't follow the HTTPS redirect by default, so serve these over plain HTTP.
    location ~ ^(/seasons/[0-9]+)?/bracket\.txt$ {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/goaccess.log combined;
    # NOTE: not access.log — in nginx:alpine that's a symlink to /dev/stdout inside the
    # nginx_logs volume, so netdata could never read it as a file.
    access_log /var/log/nginx/access_timed.log netdata_timing;

    # Compress HTML/CSS/JS/JSON — the rankings pages ship >700KB of markup
    # uncompressed. text/html is always included when gzip is on.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    # Actuator lives on the app's management port (8081, never proxied); make the
    # public path explicitly 404 instead of falling through to the app's error page.
    location /actuator/ {
        return 404;
    }

    location / {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache deepfij;
        proxy_cache_key $scheme$host$request_uri;
        proxy_cache_bypass $deepfij_cookie_skip $deepfij_uri_skip;
        proxy_no_cache $deepfij_cookie_skip $deepfij_uri_skip;
        # The app marks everything no-store (Spring Security default); freshness
        # for anonymous pages is governed here instead. Set-Cookie responses are
        # still never cached (nginx default — deliberately NOT ignored).
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_valid 200 301 302 60s;
        # Collapse concurrent misses into one upstream request, and keep serving
        # a stale copy while refreshing or if the app is down/overloaded.
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status always;
    }
}

server {
    listen 8888 ssl;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    auth_basic "Analytics";
    auth_basic_user_file /etc/nginx/htpasswd;

    location /ws {
        proxy_pass http://goaccess:7890;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 7d;
    }

    location / {
        root /var/www/goaccess;
        index index.html;
        try_files $uri $uri/ =404;
    }
}

# Internal-only stub_status for Netdata's nginx collector. Port 8080 is NOT published
# in docker-compose, so it is reachable only from other containers on the compose network.
server {
    listen 8080;
    server_name _;
    access_log off;

    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        allow 172.16.0.0/12;   # docker bridge networks
        allow 192.168.0.0/16;  # docker bridge networks (later address pools)
        deny all;
    }
}

# Netdata dashboard, remote access behind TLS + basic auth.
# Requires port 9999 to be opened in the Hetzner firewall; netdata's own 19999 stays
# bound to 127.0.0.1 on the host and is never exposed directly.
server {
    listen 9999 ssl;
    server_name fijimf.com www.fijimf.com;

    ssl_certificate /etc/letsencrypt/live/fijimf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fijimf.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    auth_basic "Monitoring";
    auth_basic_user_file /etc/nginx/htpasswd;

    location / {
        proxy_pass http://netdata:19999;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1d;
        proxy_store off;
    }
}
